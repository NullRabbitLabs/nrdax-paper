@misc{cve-2023-33297,
  title        = {{CVE-2023-33297}},
  howpublished = {\url{https://nvd.nist.gov/vuln/detail/CVE-2023-33297}},
  year         = {2023},
  note         = {NVD describes this as CPU consumption from inefficient
                  draining of the inventory-to-send queue (CWE-400), exploited
                  in the wild May 2023. The NRDAX reproduction (NRDAX-T0345)
                  measured the egress effect, in excess of 100 MB/s of upload,
                  and classifies it response\_amp on that basis. The two
                  readings are of the same defect; where they differ this paper
                  cites the reproduction as its own evidence and NVD as the
                  disclosure.}
}

